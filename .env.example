DB = 'mongodb://localhost:27017/voip'
# Use hex characters only, it is embedded in the database URL. Generate with: openssl rand -hex 24
MONGO_PASSWORD = 'CHANGE_ME'
PORT = 3000
# Public hostname. docker-compose serves the app at https://DOMAIN/ and derives BASE_URL and HTTPS from it.
DOMAIN = 'voip.example.com'
BASE_URL = 'https://localhost/'
# Sign session cookies and login tokens. The app refuses to start without two
# values of its own. Generate each with: openssl rand -hex 32
COOKIE_KEY = CHANGE_ME
COOKIE_KEY2 = CHANGE_ME
# 'on' allows anyone to create an account. Set to 'off' once your accounts exist.
SIGNUPS = 'on'
# Public key from the Telnyx portal (Account Settings > Keys & Credentials > Public Key).
# Telnyx webhooks are rejected while this is empty. Several keys can be separated by commas.
TELNYX_PUBLIC_KEY =
HTTPS = 'false'
APPDIRECTORY = 'voip'
